    XF86AudioPlay {
        spawn "playerctl" "play-pause"
    } // Custom Bind 60
    XF86AudioPrev {
        spawn "playerctl" "previous"
    } // Custom Bind 61
    XF86AudioNext {
        spawn "playerctl" "next"
    } // Custom Bind 62
    XF86AudioMedia repeat=false {
        spawn "playerctl" "play-pause"
    } // Custom Bind 63
    XF86AudioStop repeat=false {
        spawn "playerctl" "stop"
    } // Custom Bind 64
    XF86AudioRaiseVolume repeat=false {
        spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "10%+"
    } // Custom Bind 65
    XF86AudioLowerVolume repeat=false {
        spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "10%-"
    } // Custom Bind 66
    XF86AudioMute repeat=false {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"
    } // Custom Bind 67
    XF86MonBrightnessUp {
        spawn "sh" "-c" "echo brightness-up > \"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ambxst_ipc.pipe\""
    } // Custom Bind 68
    XF86MonBrightnessDown {
        spawn "sh" "-c" "echo brightness-down > \"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/ambxst_ipc.pipe\""
    } // Custom Bind 69
    XF86Calculator {
        spawn "notify-send" "Soon"
    } // Custom Bind 70
    Mod+Alt+V {
        move-window-to-workspace "special"
    } // Custom Bind 72
    Mod+Up {
        focus-window-up
