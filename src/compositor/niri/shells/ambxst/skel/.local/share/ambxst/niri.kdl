// Skipped binds (no niri equivalent — wire these manually if needed):
//   Custom Bind 0 — exec (key "Super_L": niri fires binds on press, so binding the modifier key itself would trigger on every Super press and interfere with Super+key combos; niri has no press-Super-alone (release-based) bind support)
//   Custom Bind 52 — workspace (key "mouse_down" has no niri equivalent)
//   Custom Bind 53 — workspace (key "mouse_up" has no niri equivalent)
//   Custom Bind 58 — movewindow (dispatcher not supported in niri)
//   Custom Bind 59 — resizewindow (dispatcher not supported in niri)
//   Custom Bind 71 — togglespecialworkspace (dispatcher not supported in niri)
//   Custom Bind 73 — exec (key "switch:Lid Switch" has no niri equivalent)
//   Custom Bind 74 — exec (key "switch:on:Lid Switch" has no niri equivalent)
//   Custom Bind 75 — exec (key "switch:off:Lid Switch" has no niri equivalent)

// Generated by axctl (window rules)


// Layer rule "quickshell": not supported in niri: no_anim
// Layer rule "quickshell": not supported in niri: blur
// Layer rule "quickshell": not supported in niri: blur_popups
// Layer rule "quickshell": not supported in niri: ignore_alpha
// Layer rule "selection": not supported in niri: no_anim
// Layer rule "fabric": not supported in niri: blur
// Layer rule "^ambxst(:.*)?$": not supported in niri: no_anim; blur; blur_popups
layer-rule {
    match namespace="^ambxst:wallpaper$"
    place-within-backdrop true
}

