// ─────────────────────────────────────────────────────────────────────────────
// 40 — Environment variables
// ─────────────────────────────────────────────────────────────────────────────
// These are set for every process spawned by Niri (including spawn-at-startup
// and keybind commands). They are NOT inherited by TTY/SSH sessions — for
// those, iNiR's setup writes equivalent exports into ~/.bashrc / fish conf.d.
// ─────────────────────────────────────────────────────────────────────────────

environment {
    // Tell apps which compositor is running (used by xdg-desktop-portal, etc.).
    XDG_CURRENT_DESKTOP "niri"

    // Use Plasma's app-menu prefix so kbuildsycoca6 indexes .desktop files
    // and Dolphin/Nautilus "Open With" menus work correctly.
    XDG_MENU_PREFIX "plasma-"

    // Force Qt apps to use Wayland natively (no XWayland fallback).
    QT_QPA_PLATFORM "wayland"

    // Let Electron apps (Chrome, VS Code, Discord) pick Wayland automatically.
    ELECTRON_OZONE_PLATFORM_HINT "auto"

    // Silence noisy Quickshell D-Bus property logs.
    QT_LOGGING_RULES "quickshell.dbus.properties=false"

    // Qt theming. "kde" reads colours out of kdeglobals through
    // plasma-integration, which upstream already carried when this skel was
    // written and the install plan now puts there as well (see
    // src/shells/inir.rs): with the package present this is the value iNiR's own
    // setup wants, and its doctor rewrites the line to "kde" whenever it finds
    // anything else — including in this file, which it edits in place. Without
    // plasma-integration iNiR falls back to qt6ct, which reads the Darkly scheme
    // it renders into ~/.config/qt6ct/qt6ct.conf; that is still what the image's
    // own session files (~/.config/uwsm/env, environment.d) say, but Qt only
    // ever looks at the variable below.
    //
    // The image's /usr/share/niri/global.kdl sets a gtk3 platform theme of its
    // own, in a block that is included before this one; this value is the one
    // that reaches the session. (The `QT_QPA_PLATFORMTHEME_QT6` it also sets is
    // read by no Qt library — only by DMS's settings — so it is left alone.)
    QT_QPA_PLATFORMTHEME "kde"

    // Darkly is a modern Qt style that follows the colour scheme it is pointed
    // at; iNiR renders that scheme as Darkly.colors and qt6ct names it.
    QT_STYLE_OVERRIDE "Darkly"

    // Python venv used by iNiR scripts (color generation, AI features, translations).
    INIR_VENV "$HOME/.local/state/quickshell/.venv"
    ILLOGICAL_IMPULSE_VIRTUAL_ENV "$HOME/.local/state/quickshell/.venv"
}
