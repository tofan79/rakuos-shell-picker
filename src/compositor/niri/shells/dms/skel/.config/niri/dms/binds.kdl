binds {
    Ctrl+Alt+Delete hotkey-overlay-title="Task Manager" { spawn "dms" "ipc" "call" "processlist" "toggle"; }
    Mod+Ctrl+M hotkey-overlay-title="Task Manager" { spawn "dms" "ipc" "call" "processlist" "toggle"; }
    Mod+Ctrl+R { spawn "dms" "restart"; }
    Mod+E { spawn "dms" "ipc" "powermenu" "toggle"; }
    Mod+K hotkey-overlay-title="Open Hotkey overlay" { spawn "dms" "ipc" "call" "keybinds" "toggle" "niri"; }
    Mod+N hotkey-overlay-title="Notification Center" { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+P hotkey-overlay-title="Color Picker" { spawn "dms" "ipc" "color-picker" "toggle"; }
    Mod+S hotkey-overlay-title="Settings" { spawn "dms" "ipc" "call" "settings" "toggle"; }
    Mod+Shift+N hotkey-overlay-title="Notepad" { spawn "dms" "ipc" "call" "notepad" "toggle"; }
    Mod+Shift+P { spawn "dms" "color" "pick" "-a"; }
    Mod+Shift+space hotkey-overlay-title="Spotlight Search" { spawn "dms" "ipc" "call" "spotlight-bar" "toggle"; }
    Mod+V hotkey-overlay-title="Clipboard Manager" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+Y hotkey-overlay-title="Browse Wallpapers" { spawn "dms" "ipc" "call" "dankdash" "wallpaper"; }
    Mod+space hotkey-overlay-title="Application Launcher" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Lower Volume" { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    XF86AudioMicMute allow-when-locked=true hotkey-overlay-title="Mute Microfon" { spawn "dms" "ipc" "call" "audio" "micmute"; }
    XF86AudioMute allow-when-locked=true hotkey-overlay-title="Mute Audio" { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioNext allow-when-locked=true hotkey-overlay-title="Next Track" { spawn "dms" "ipc" "call" "mpris" "next"; }
    XF86AudioPlay allow-when-locked=true hotkey-overlay-title="Play/Pause Music" { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPrev allow-when-locked=true hotkey-overlay-title="Previous Track" { spawn "dms" "ipc" "call" "mpris" "previous"; }
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Raise Volume" { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    XF86AudioStop allow-when-locked=true hotkey-overlay-title="Stop Music" { spawn "dms" "ipc" "call" "mpris" "stop"; }
    XF86MonBrightnessDown hotkey-overlay-title="Decrease Brightness" allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }
    XF86MonBrightnessUp allow-when-locked=true hotkey-overlay-title="Increase Brightness" { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Alt+Down { focus-workspace-down; }
    Mod+Alt+Up { focus-workspace-up; }
    Mod+Ctrl+Down { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+Up { move-column-to-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+I { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+I { move-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up { move-workspace-up; }
    Mod+Shift+U { move-workspace-down; }
    Mod+Shift+W hotkey-overlay-title="Open Workspace Config" { spawn-sh "xdg-open ~/.config/niri/workspaces.kdl"; }
    Mod+Shift+aacute { move-column-to-workspace 8; }
    Mod+Shift+ccaron { move-column-to-workspace 4; }
    Mod+Shift+ecaron { move-column-to-workspace 2; }
    Mod+Shift+iacute { move-column-to-workspace 9; }
    Mod+Shift+plus { move-column-to-workspace 1; }
    Mod+Shift+rcaron { move-column-to-workspace 5; }
    Mod+Shift+scaron { move-column-to-workspace 3; }
    Mod+Shift+yacute { move-column-to-workspace 7; }
    Mod+Shift+zcaron { move-column-to-workspace 6; }
    Mod+U { focus-workspace-down; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+aacute { focus-workspace 8; }
    Mod+ccaron { focus-workspace 4; }
    Mod+ecaron { focus-workspace 2; }
    Mod+iacute { focus-workspace 9; }
    Mod+plus { focus-workspace 1; }
    Mod+rcaron { focus-workspace 5; }
    Mod+scaron { focus-workspace 3; }
    Mod+yacute { focus-workspace 7; }
    Mod+zcaron { focus-workspace 6; }
    Alt+Print { screenshot-window; }
    Alt+XF86Launch1 { screenshot-window; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Ctrl+End { move-column-to-last; }
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Ctrl+K { focus-monitor-up; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Left { set-column-width "-3%"; }
    Mod+Ctrl+Right { set-column-width "+3%"; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp { move-column-left; }
    Mod+Ctrl+WheelScrollLeft { move-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Down { focus-window-down; }
    Mod+End { focus-column-last; }
    Mod+F11 { fullscreen-window; }
    Mod+G { toggle-window-floating; }
    Mod+Home { focus-column-first; }
    Mod+Left { focus-column-left; }
    Mod+M { maximize-column; }
    Mod+MouseBack { focus-column-left; }
    Mod+MouseForward { focus-column-right; }
    Mod+Period { expel-window-from-column; }
    Mod+Q repeat=false { close-window; }
    Mod+R { switch-preset-column-width; }
    Mod+Right { focus-column-right; }
    Mod+Shift+A hotkey-overlay-title="Open Window Rules Config" { spawn-sh "xdg-open ~/.config/niri/windowrules.kdl"; }
    Mod+Shift+Alt+R { reset-window-height; }
    Mod+Shift+Ctrl+Down { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+H { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up { move-column-to-monitor-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Shift+F { expand-column-to-available-width; }
    Mod+Shift+F11 { toggle-windowed-fullscreen; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+M { maximize-window-to-edges; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+Up { focus-window-up; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+Ctrl+Escape { power-off-monitors; }
    Ctrl+Print { screenshot-screen; }
    Ctrl+XF86Launch1 { screenshot-screen; }
    Print { screenshot; }
    XF86Launch1 { screenshot; }
    Mod+Shift+E { quit; }
    Mod+B hotkey-overlay-title="Open Browser" { spawn-sh "xdg-open about:newtab"; }
    Mod+Ctrl+Alt+M hotkey-overlay-title="Open Resources" { spawn-sh "flatpak run net.nokyan.Resources"; }
    Mod+Ctrl+Shift+M hotkey-overlay-title="Open Resources" { spawn-sh "flatpak run net.nokyan.Resources"; }
    Mod+Escape hotkey-overlay-title="Supend" { spawn "systemctl" "suspend" "-i"; }
    Mod+F hotkey-overlay-title="Open File Manager" { spawn "nautilus"; }
    Mod+Shift+C hotkey-overlay-title="Open Niri Config" { spawn-sh "xdg-open ~/.config/niri/config.kdl"; }
    Mod+Shift+D hotkey-overlay-title="Open Defaults Config" { spawn-sh "xdg-open ~/.config/mimeapps.list"; }
    Mod+Shift+Escape { spawn "loginctl" "lock-session"; }
    Mod+Shift+S hotkey-overlay-title="Open Niri Config" { spawn-sh "xdg-open ~/.config/niri/config.kdl"; }
    Mod+T hotkey-overlay-title="Open Terminal" { spawn "ghostty"; }
    Mod+comma hotkey-overlay-title="Open RakuOS Docs" { spawn-sh "xdg-open https://rakuos.org/documentation"; }
    Mod+question hotkey-overlay-title="Open RakuOS Docs" { spawn-sh "xdg-open https://rakuos.org/documentation"; }
    XF86Calculator hotkey-overlay-title="Open Calculator" { spawn-sh "flatpak run org.gnome.Calculator"; }
    XF86Mail hotkey-overlay-title="Open Mail" { spawn-sh "xdg-open https://mail.proton.me"; }
    Mod+D hotkey-overlay-title="Open Overview" { toggle-overview; }
    Mod+Shift+K { show-hotkey-overlay; }
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Tab repeat=false { toggle-overview; }
}
